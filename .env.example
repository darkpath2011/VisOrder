# Public Supabase (safe for browser / NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=

# Optional: configure these in the Supabase Auth dashboard (GitHub provider),
# not as Next.js runtime env unless you add a custom OAuth flow.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
